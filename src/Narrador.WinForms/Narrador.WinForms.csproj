<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\narrador.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <EmbeddedResource Include="Assets\narrador.ico" LogicalName="Narrador.AppIcon" />
    <Content Include="..\..\.tools\ffmpeg\ffmpeg.exe" Condition="Exists('..\..\.tools\ffmpeg\ffmpeg.exe')" Link="tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\.tools\ffmpeg\LICENSE*" Link="tools\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\.tools\ffmpeg\BUILD.txt" Condition="Exists('..\..\.tools\ffmpeg\BUILD.txt')" Link="tools\ffmpeg\BUILD.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="..\Narrador.Application\Narrador.Application.csproj" />
    <ProjectReference Include="..\Narrador.Infrastructure\Narrador.Infrastructure.csproj" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\SoundTouch.Net-LGPL-2.1.txt" Link="licenses\SoundTouch.Net-LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\LibVLC-LGPL-2.1.txt" Link="licenses\LibVLC-LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
